# Copy this file to .env and fill in your values
# Never commit the real .env file

# Primary LLM: Groq (Recommended, fast & free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cost configuration (assumed cloud rate – honest label in UI)
COST_PER_GPU_SECOND=0.0004

# GPU power fallback (watts) when pynvml is unavailable
GPU_WATTS_FALLBACK=150

# Image generation settings
POSTER_STEPS=25
CACHE_THRESHOLD=0.88

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DB_PATH=./backend/purposecanvas.db
CHROMA_PATH=./backend/chroma_db
